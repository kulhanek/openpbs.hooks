# ---------------------------------------------------------------------------
# hook job_env
# ---------------------------------------------------------------------------

#
# Run after job_cgroups_v2 (order 10), job_gpus (order 20), workspace (order 30) 
# because this hook may require setup performed there.
#

# hook -------------------------------------------

create hook job_env
set hook job_env type = site
set hook job_env enabled = true
set hook job_env event = execjob_begin
set hook job_env user = pbsadmin
set hook job_env alarm = 60
set hook job_env order = 40
set hook job_env debug = false
set hook job_env fail_action = none

import hook job_env application/x-python default /root/openpbs.hooks/hook_job_env.py

