# ---------------------------------------------------------------------------
# CPU request normalization / MPI+OpenMP validation
# ---------------------------------------------------------------------------

# resources --------------------------------------

# Preserve the select expression as submitted before hook normalization.
# This is metadata only; do not add user_select to sched_config resources.

create resource user_select
set resource user_select type = string 

# hook -------------------------------------------

create hook normalize_job_mpiomp
set hook normalize_job_mpiomp type = site
set hook normalize_job_mpiomp enabled = true
set hook normalize_job_mpiomp event = queuejob
set hook normalize_job_mpiomp user = pbsadmin
set hook normalize_job_mpiomp alarm = 30
set hook normalize_job_mpiomp order = 10
set hook normalize_job_mpiomp debug = false
set hook normalize_job_mpiomp fail_action = none

import hook normalize_job_mpiomp application/x-python default /root/openpbs.hooks/hook_normalize_job_mpiomp.py


