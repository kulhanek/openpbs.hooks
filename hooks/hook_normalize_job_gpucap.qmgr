# ---------------------------------------------------------------------------
# gpu_cap normalization
# ---------------------------------------------------------------------------

# hook -------------------------------------------

create hook normalize_job_gpucap
set hook normalize_job_gpucap type = site
set hook normalize_job_gpucap enabled = true
set hook normalize_job_gpucap event = queuejob
set hook normalize_job_gpucap user = pbsadmin
set hook normalize_job_gpucap alarm = 30
set hook normalize_job_gpucap order = 10
set hook normalize_job_gpucap debug = false
set hook normalize_job_gpucap fail_action = none

import hook normalize_job_gpucap application/x-python default /root/openpbs.hooks/hook_normalize_job_gpucap.py

# the configuration is shared with hook_discovery_gpus
import hook normalize_job_gpucap application/x-config default /root/openpbs.hooks/hook_discovery_gpus.json

