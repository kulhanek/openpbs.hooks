# ---------------------------------------------------------------------------
# discovery CPUs and memory
# ---------------------------------------------------------------------------

# CPU specification --------------------

create resource cpu_model
set resource cpu_model type = string
set resource cpu_model flag = h

create resource cpu_vendor
set resource cpu_vendor type = string
set resource cpu_vendor flag = h

create resource cpu_flag
set resource cpu_flag type = string_array
set resource cpu_flag flag = h

create resource spec
set resource spec type = float
set resource spec flag = h

create resource cpu_isa
set resource cpu_isa type = string_array
set resource cpu_isa flag = h

# CPU resources --------------------

create resource nthreads
set resource nthreads type = long
set resource nthreads flag = hn

create resource smt
set resource smt type = boolean
set resource smt flag = h

create resource hybrid_cpu
set resource hybrid_cpu type = boolean
set resource hybrid_cpu flag = h

create resource npus_per_core
set resource npus_per_core type = string
set resource npus_per_core flag = h

# hook -------------------------------------------

create hook discovery_cpus
set hook discovery_cpus type = site
set hook discovery_cpus enabled = true
set hook discovery_cpus event = exechost_startup
set hook discovery_cpus event += exechost_periodic
set hook discovery_cpus user = pbsadmin
set hook discovery_cpus alarm = 30
set hook discovery_cpus freq = 3600
set hook discovery_cpus order = 20
set hook discovery_cpus debug = false
set hook discovery_cpus fail_action = none

import hook discovery_cpus application/x-python default /root/openpbs.hooks/hook_discovery_cpus.py
import hook discovery_cpus application/x-config default /root/openpbs.hooks/hook_discovery_cpus.json
