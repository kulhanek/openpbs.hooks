# ---------------------------------------------------------------------------
# hook_aggregate_resources
# ---------------------------------------------------------------------------

create resource all_gpu_caps type=string_array
create resource all_cpu_isas type=string_array

create hook aggregate_resources
set hook aggregate_resources type = site
set hook aggregate_resources enabled = true
set hook aggregate_resources event = periodic
set hook aggregate_resources user = pbsadmin
set hook aggregate_resources alarm = 30
set hook aggregate_resources freq = 300
set hook aggregate_resources debug = false
set hook aggregate_resources fail_action = none

import hook aggregate_resources application/x-python default /root/openpbs.hooks/hook_aggregate_resources.py
import hook aggregate_resources application/x-config default /root/openpbs.hooks/hook_aggregate_resources.json
