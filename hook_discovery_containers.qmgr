# Resource used to advertise container runtimes available on execution hosts.
create resource containers type=string_array flags=h

# Execution-host discovery hook.
create hook hook_discovery_containers
set hook hook_discovery_containers event = exechost_startup,exechost_periodic
set hook hook_discovery_containers enabled = true
set hook hook_discovery_containers alarm = 30
set hook hook_discovery_containers freq = 3600

# Import the hook implementation and its JSON configuration.
import hook hook_discovery_containers application/x-python default hook_discovery_containers.py
import hook hook_discovery_containers application/x-config default hook_discovery_containers.json
