{
  "state_subdir": "workspace",
  "scan_refresh": 7200,
  "fallback_dir": "/var/tmp/pbs.$PBS_JOBID",
  "scratch_local": {
    "discover": true,
    "subtypes": [
      {
        "name": "nvme",
        "priority": 300,
        "mount_point": "/scratch",
        "source_patterns": [
          "/dev/nvme*"
        ],
        "rotational": false,
        "filesystem_patterns": [
          "ext4",
          "xfs"
        ],
        "job_dir": "/scratch/$USER/batch_system_jobs/job_$PBS_JOBID_SHORT",
        "accounting_root": "/scratch",
        "preserve_nonempty": true
      },
      {
        "name": "ssd",
        "priority": 200,
        "mount_point": "/scratch",
        "source_patterns": [
          "/dev/sd*",
          "/dev/mapper/ssd-*"
        ],
        "rotational": false,
        "filesystem_patterns": [
          "ext4",
          "xfs"
        ],
        "job_dir": "/scratch/$USER/batch_system_jobs/job_$PBS_JOBID_SHORT",
        "accounting_root": "/scratch",
        "preserve_nonempty": true
      },
      {
        "name": "hdd",
        "priority": 100,
        "mount_point": "/scratch",
        "source_patterns": [
          "/dev/sd*",
          "/dev/mapper/hdd-*"
        ],
        "rotational": true,
        "filesystem_patterns": [
          "ext4",
          "xfs"
        ],
        "job_dir": "/scratch/$USER/batch_system_jobs/job_$PBS_JOBID_SHORT",
        "accounting_root": "/scratch",
        "preserve_nonempty": true
      }
    ]
  },
  "scratch_shared": {
    "discover": true,
    "subtypes": [
      {
        "name": "nfs",
        "priority": 100,
        "mount_point": "/scratch.shared",
        "source_patterns": [
          "*"
        ],
        "filesystem_patterns": [
          "nfs",
          "nfs4"
        ],
        "job_dir": "/scratch.shared/$USER/batch_system_jobs/job_$PBS_JOBID_SHORT",
        "accounting_root": "/scratch.shared",
        "preserve_nonempty": true
      },
      {
        "name": "lustre",
        "priority": 100,
        "mount_point": "/scratch.shared",
        "source_patterns": [
          "*"
        ],
        "filesystem_patterns": [
          "lustre"
        ],
        "job_dir": "/scratch.shared/$USER/batch_system_jobs/job_$PBS_JOBID_SHORT",
        "accounting_root": "/scratch.shared",
        "preserve_nonempty": true
      },
      {
        "name": "ceph",
        "priority": 100,
        "mount_point": "/scratch.shared",
        "source_patterns": [
          "*"
        ],
        "filesystem_patterns": [
          "ceph"
        ],
        "job_dir": "/scratch.shared/$USER/batch_system_jobs/job_$PBS_JOBID_SHORT",
        "accounting_root": "/scratch.shared",
        "preserve_nonempty": true
      },
      {
        "name": "gpfs",
        "priority": 100,
        "mount_point": "/scratch.shared",
        "source_patterns": [
          "*"
        ],
        "filesystem_patterns": [
          "gpfs"
        ],
        "job_dir": "/scratch.shared/$USER/batch_system_jobs/job_$PBS_JOBID_SHORT",
        "accounting_root": "/scratch.shared",
        "preserve_nonempty": true
      }
    ]
  },
  "scratch_shm": {
    "discover": true,
    "subtypes": [
      {
        "name": "tmpfs",
        "priority": 100,
        "mount_point": "/dev/shm",
        "source_patterns": [
          "tmpfs",
          "shm",
          "*"
        ],
        "filesystem_patterns": [
          "tmpfs"
        ],
        "job_dir": "/dev/shm/$USER/batch_system_jobs/job_$PBS_JOBID_SHORT",
        "preserve_nonempty": false
      }
    ]
  }
}
