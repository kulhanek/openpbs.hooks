# ---------------------------------------------------------------------------
# CPU request normalization / MPI+OpenMP validation
# ---------------------------------------------------------------------------

# hook -------------------------------------------

create hook job_enqueued
set hook job_enqueued type = site
set hook job_enqueued enabled = true
set hook job_enqueued event = queuejob
set hook job_enqueued user = pbsadmin
set hook job_enqueued alarm = 30
set hook job_enqueued order = 10
set hook job_enqueued debug = false
set hook job_enqueued fail_action = none

import hook job_enqueued application/x-python default /root/openpbs.hooks/hook_job_enqueued.py


