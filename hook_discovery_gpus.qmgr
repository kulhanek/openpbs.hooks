# ---------------------------------------------------------------------------
# discovery GPUs
# ---------------------------------------------------------------------------

# resources --------------------------------------

create resource ngpus
set resource ngpus type = long
set resource ngpus flag = hn

create resource gpu_vendor
set resource gpu_vendor type = string
set resource gpu_vendor flag = h

create resource gpu_model
set resource gpu_model type = string_array
set resource gpu_model flag = h

create resource gpu_cap
set resource gpu_cap type = string_array
set resource gpu_cap flag = h

create resource gpu_arch
set resource gpu_arch type = string_array
set resource gpu_arch flag = h

create resource gpu_mem
set resource gpu_mem type = size
set resource gpu_mem flag = h

create resource cuda_version
set resource cuda_version type = string
set resource cuda_version flag = h

# hook -------------------------------------------

create hook discovery_gpus
set hook discovery_gpus type = site
set hook discovery_gpus enabled = true
set hook discovery_gpus event = exechost_startup
set hook discovery_gpus event += exechost_periodic
set hook discovery_gpus user = pbsadmin
set hook discovery_gpus alarm = 30
set hook discovery_gpus freq = 1800
set hook discovery_gpus order = 30
set hook discovery_gpus debug = false
set hook discovery_gpus fail_action = none

import hook discovery_gpus application/x-python default /root/openpbs.hooks/hook_discovery_gpus.py
import hook discovery_gpus application/x-config default /root/openpbs.hooks/hook_discovery_gpus.json
